# Copy to the backend repo root as ".env" (deploy/setup-server.sh does this for you)

# Public hostname. Free options:
#   - DuckDNS:  legaldocs-yourname.duckdns.org   (free subdomain, point it at the server IP)
#   - sslip.io: 129-213-10-20.sslip.io           (zero setup, just the IP with dashes)
DOMAIN=
# Leave empty normally. Set to :80 only when running behind Cloudflare Tunnel (it provides the HTTPS).
SITE_ADDRESS=

# AI provider: "groq" (free key at https://console.groq.com/keys) or "openai"
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# Demo account shown on the login page ("Try the demo account" button) - great for recruiters
DEMO_EMAIL=demo@legaldocsgpt.com
DEMO_PASSWORD=Demo1234!

# Admin account (username: admin)
ADMIN_PASSWORD=change-me

# Secrets (setup-server.sh generates these automatically)
POSTGRES_USER=legaldocs
POSTGRES_PASSWORD=
# JWT_SECRET: base64, >= 32 bytes  (openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION=86400000
MINIO_ROOT_USER=legaldocs
MINIO_ROOT_PASSWORD=
RABBITMQ_USER=legaldocs
RABBITMQ_PASSWORD=
EDIT_TOKEN_SECRET=
# ONLYOFFICE_JWT_SECRET: >= 32 chars  (openssl rand -hex 32)
ONLYOFFICE_JWT_SECRET=

# Optional: Google sign-in
# Add https://DOMAIN/api/auth/login/oauth2/code/google as an authorised redirect URI in Google Cloud Console
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: SMTP for password-reset emails (e.g. Brevo / Gmail app password)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=LegaldocsGPT <noreply@example.com>

# Where the frontend repo is checked out, relative to this folder
FRONTEND_PATH=../frontend
