# ── Copy this to .env and fill in all values ──────────────────────────────────
# Never commit .env to git — it is already in .gitignore

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=auth_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=86400000

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
# Leave blank to use RabbitMQ defaults (guest/guest) in dev
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── OnlyOffice ─────────────────────────────────────────────────────────────────
ONLYOFFICE_JWT_SECRET=

# ── Edit tokens (storage-service ↔ document-generator) ────────────────────────
EDIT_TOKEN_SECRET=

# ── AI providers ──────────────────────────────────────────────────────────────
# AI_PROVIDER must be either "openai" or "groq"
AI_PROVIDER=groq
OPENAI_API_KEY=
GROQ_API_KEY=


