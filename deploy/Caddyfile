{$SITE_ADDRESS} {
	encode zstd gzip

	# OnlyOffice under a virtual path (X-Forwarded-Host must include the prefix)
	handle_path /onlyoffice/* {
		reverse_proxy onlyoffice-ds:80 {
			header_up X-Forwarded-Host {host}/onlyoffice
			header_up X-Forwarded-Proto https
		}
	}

	handle /api/* {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy frontend:3000
	}

	request_body {
		max_size 25MB
	}
}
